# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=tradeflow_db
DB_CONNECTION_LIMIT=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SHORT=300
REDIS_TTL_MEDIUM=1800
REDIS_TTL_LONG=3600

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=http://localhost:5173

# Bcrypt
BCRYPT_ROUNDS=12

# External Market API (Alpha Vantage free tier)
MARKET_API_KEY=your_alpha_vantage_api_key
MARKET_API_BASE_URL=https://www.alphavantage.co/query
